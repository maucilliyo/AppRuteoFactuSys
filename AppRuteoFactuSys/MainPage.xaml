<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppRuteoFactuSys.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView VerticalOptions="Start">

        <VerticalStackLayout VerticalOptions="Start">
            <Grid
                Padding="0"
                Background="#8f4775"
                ColumnSpacing="0"
                HeightRequest="30"
                RowSpacing="0">
                <Label
                    FontAttributes="Bold, Italic"
                    HorizontalOptions="Center"
                    Text=" MENU SISTEMA PREVENTA "
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>
            <!--#region Activity-->
            <ActivityIndicator
                x:Name="activityIndicator"
                HeightRequest="60"
                IsRunning="False"
                IsVisible="False"
                WidthRequest="60"
                Color="Green" />

            <Label
                x:Name="lblActivityIndicatorText"
                FontSize="Small"
                HorizontalOptions="Center"
                IsVisible="False"
                Text="Sincronizando..."
                TextColor="Black"
                VerticalOptions="Center" />
            <!--#endregion-->
            <!--  PANEL PRINCIPAL  -->
            <Grid Padding="10" RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button
                    x:Name="btnPreventa"
                    Grid.Row="1"
                    BackgroundColor="#A568FE"
                    Clicked="btnPreventa_Clicked"
                    FontSize="12"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Text="PREVENTAS"
                    WidthRequest="150" />
                <Button
                    x:Name="btnFacturadas"
                    Grid.Row="2"
                    BackgroundColor="#349267"
                    Clicked="btnFacturadas_Clicked"
                    FontSize="12"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Text="ENTREGADAS"
                    WidthRequest="150" />

                <Button
                    x:Name="btnNotas"
                    Grid.Row="3"
                    BackgroundColor="#424242"
                    Clicked="btnNotas_Clicked"
                    FontSize="12"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Text="DEVOLUCIONES"
                    WidthRequest="150" />

                <Button
                    x:Name="btnSincronizar"
                    Grid.Row="4"
                    BackgroundColor="#4887A7"
                    Clicked="btnSincronizar_Clicked"
                    FontSize="12"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Text="SINCONIZAR"
                    WidthRequest="150" />
                <Button
                    x:Name="btnConexion"
                    Grid.Row="5"
                    BackgroundColor="Chocolate"
                    Clicked="btnConexion_Clicked"
                    FontSize="12"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Text="CONEXION"
                    WidthRequest="150" />

                <Button
                    x:Name="btnResetDB"
                    Grid.Row="6"
                    BackgroundColor="#CA5100"
                    Clicked="btnEliminarDB_Clicked"
                    FontSize="12"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Text="Resetear BD local"
                    WidthRequest="150" />

                <!--  IMAGEN  -->
                <Image Grid.Row="7" Source="fondo_menu.png" />

                <Label
                    Grid.Row="8"
                    FontAttributes="Bold, Italic"
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text=" Distribuidora La Familia E R "
                    TextColor="Black"
                    VerticalOptions="Center" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
