<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppRuteoFactuSys.Views.Devoluciones.ListaDevolucionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dg="clr-namespace:Maui.DataGrid;assembly=Maui.DataGrid"
    Padding="2,0,5,2">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  // BUSCAR  -->

        <Button
            x:Name="btnNuevaNota"
            Clicked="btnNuevaNota_Clicked"
            HeightRequest="40"
            Text="NUEVA"
            WidthRequest="150" />

        <Grid Grid.Row="1">
            <Label
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                Text="LISTA DE DEVOLUCIONES" />
        </Grid>
        <!--  PANEL PRINCIPAL  -->
        <!--  DataGrid Cuenta  -->

        <!--  Header fijo  -->
        <Grid
            Grid.Row="2"
            Margin="3,12,3,0"
            RowDefinitions="Auto,*">

            <!--  Encabezado manual  -->
            <Grid
                Padding="5"
                BackgroundColor="#2E61B5"
                ColumnDefinitions="*,100,35,35">
                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    Text="Nombre"
                    VerticalTextAlignment="Center" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="End"
                    Text="Total"
                    VerticalTextAlignment="Center" />

            </Grid>

            <!--  Lista de preventas  -->
            <CollectionView
                x:Name="cvPreventas"
                Grid.Row="1"
                Margin="0"
                ItemsSource="{Binding Preventas}"
                SelectedItem="{Binding SelectedPreventa}"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="2"
                            ColumnDefinitions="*,100,45"
                            RowSpacing="0">

                            <Label
                                Grid.Column="0"
                                Text="{Binding Nombre}"
                                VerticalTextAlignment="Center" />

                            <Label
                                Grid.Column="1"
                                HorizontalTextAlignment="End"
                                Text="{Binding TotalComprobante, StringFormat='{}{0:#,0}'}"
                                VerticalTextAlignment="Center" />

                            <Button
                                x:Name="btnVerDevolucion"
                                Grid.Column="2"
                                BackgroundColor="Transparent"
                                Clicked="btnVerDevolucion_Clicked"
                                Command="{Binding BindingContext.verPdfCommand, Source={x:Reference cvPreventas}}"
                                CommandParameter="{Binding .}"
                                FontSize="14"
                                Text="🖨" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!--  Mensaje si no hay datos  -->
                <CollectionView.EmptyView>
                    <Label
                        HorizontalOptions="Center"
                        Text="NO HAY DATOS"
                        VerticalOptions="Center" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>


    </Grid>

</ContentPage>