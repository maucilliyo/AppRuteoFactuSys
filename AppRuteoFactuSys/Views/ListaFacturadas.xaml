<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppRuteoFactuSys.Views.ListaFacturadas"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dg="clr-namespace:Maui.DataGrid;assembly=Maui.DataGrid">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  // BUSCAR  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>


            <Entry
                x:Name="txtBuscar"
                Grid.Column="0"
                Margin="5,0,0,0"
                CursorPosition="1"
                HorizontalOptions="Start"
                Placeholder="Nombre  a buscar"
                WidthRequest="300" />

        </Grid>
        <!--  PANEL PRINCIPAL  -->
        <!--  DataGrid Cuenta  -->
        <!--  Indicador de carga  -->
        <ActivityIndicator
            x:Name="indicador"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />

        <dg:DataGrid
            x:Name="dgPreventas"
            Grid.Row="2"
            Margin="3,10,3,0"
            BackgroundColor="{AppThemeBinding Light=White,
                                              Dark=#1C1C1C}"
            BorderColor="{AppThemeBinding Light=White,
                                          Dark=#1C1C1C}"
            HeaderBackground="#E8EED4"
            HeaderHeight="25"
            IsClippedToBounds="False"
            IsRefreshing="{Binding IsRefreshing}"
            PageSize="100"
            PaginationEnabled="True"
            PullToRefreshCommand="{Binding RefreshCommand}"
            SelectedItem="{Binding SelectedPreventa}"
            SelectionEnabled="True">
            <dg:DataGrid.NoDataView>
                <Label
                    HorizontalOptions="Center"
                    Text="NO HAY DATOS"
                    VerticalOptions="Center" />
            </dg:DataGrid.NoDataView>
            <dg:DataGrid.Columns>
                <dg:DataGridColumn
                    Title="Nombre"
                    HorizontalContentAlignment="Start"
                    PropertyName="Nombre_Cliente" />
                <dg:DataGridColumn
                    Title="Total"
                    Width="100"
                    HorizontalContentAlignment="End"
                    PropertyName="TotalComprobante"
                    StringFormat="{}{0:#,0.00}" />

                <dg:DataGridColumn Width="30">
                    <dg:DataGridColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Command="{Binding BindingContext.SendSelectedDataCommand, Source={x:Reference dgPreventas}}"
                                CommandParameter="{Binding .}"
                                Text="M" />
                        </DataTemplate>
                    </dg:DataGridColumn.CellTemplate>
                </dg:DataGridColumn>
            </dg:DataGrid.Columns>
        </dg:DataGrid>
    </Grid>
</ContentPage>